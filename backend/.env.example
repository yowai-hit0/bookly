# Bookly API — copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL 15+. The exclusion constraint that prevents double booking
# exists in no other engine (data-model_v2.md §9.1).
DATABASE_URL=postgresql://bookly:bookly@localhost:5432/bookly

# Public origin the site is served from. Emails link here, never at the API host.
WEB_ORIGIN=http://localhost:5173

# Deploy configuration, never a database row (data-model_v2.md §5.2).
# mtn_momo_direct | flutterwave
PAYMENT_PROVIDER=mtn_momo_direct
